# Copy this file to `.env` and edit. .env is gitignored.

# Where all data lives: SQLite DB + per-session audio files.
# Default: ./data  (a relative path is taken from this server folder)
AFTERWORD_DATA_DIR=./data

# Network bind.
#   AFTERWORD_HOST=127.0.0.1   # only this PC (default)
#   AFTERWORD_HOST=0.0.0.0     # other devices too, e.g. the recorder; then
#                              # AFTERWORD_WEB_PASSWORD below is required
AFTERWORD_HOST=127.0.0.1
AFTERWORD_PORT=8000

# API keys. Both the transcription model and the text model are
# called through OpenRouter (https://openrouter.ai/), so the same
# key works for both — paste it in both lines.
#   AFTERWORD_TRANSCRIPTION_API_KEY   audio → text  (microsoft/mai-transcribe-2)
#   AFTERWORD_TEXT_API_KEY            summaries, key points, classification
AFTERWORD_TRANSCRIPTION_API_KEY=
AFTERWORD_TEXT_API_KEY=

# Models (OpenRouter slugs). Defaults: microsoft/mai-transcribe-2 and
# minimax/minimax-m3. Speaker labels need a transcription model that
# returns verbose_json segments (e.g. not openai/gpt-4o-transcribe).
# AFTERWORD_TRANSCRIPTION_MODEL=microsoft/mai-transcribe-2
# AFTERWORD_TEXT_MODEL=minimax/minimax-m3

# Text model from another OpenAI-compatible API instead of OpenRouter.
# For a MiniMax subscription, put its key (sk-cp-..., not the
# pay-as-you-go sk-api-... key) in AFTERWORD_TEXT_API_KEY and set:
# AFTERWORD_TEXT_BASE_URL=https://api.minimax.io/v1
# AFTERWORD_TEXT_MODEL=MiniMax-M3            (or MiniMax-M3.1-Flash: ~3x faster)

# Summary language. A recording in one of these languages is summarised
# in that language; any other language is translated into the first.
# AFTERWORD_SUMMARY_LANGUAGES=English, Russian

# Speaker annotations. When the transcription model returns
# diarization data, transcripts are rendered as
# "[MM:SS] Speaker N: ..." lines. Set to 0 to always get plain text.
AFTERWORD_TRANSCRIBE_SPEAKERS=1

# Long stitched recordings are automatically split into pieces for
# transcription. Canonical storage is AAC (~8 KB/s), so the default
# 1500 s (25 min) is ~12 MB per request (well under OpenRouter's
# caps), meaning a 2-hour lecture is ~5 requests. Pieces are cut
# with ffmpeg stream-copy (no re-encode). Pieces that fail upstream
# (timeout, 5xx, oversized body) are automatically cut in half and
# retried.
AFTERWORD_TRANSCRIBE_CHUNK_SECONDS=1500

# Provider-specific options for the transcription request (JSON
# object). The default enables Azure diarization, which is required
# for speaker labels on microsoft/mai-transcribe-2. Only change
# this if you switch to a model served by a different provider;
# set to {} to send no provider options.
# AFTERWORD_TRANSCRIBE_PROVIDER_OPTIONS={"azure":{"diarization":{"enabled":true}}}

# Background AI pipeline. After a chunk upload or a device finish,
# the server stitches immediately and then transcribes/summarises
# in the background, one session at a time (FIFO). Set to 0 to run
# the whole pipeline synchronously inside the request instead
# (much slower HTTP responses; mainly useful for debugging).
AFTERWORD_PIPELINE_BACKGROUND=1

# Web upload.
# ffmpeg is required for the whole AAC pipeline: web uploads in any
# non-AAC format are transcoded to canonical AAC-LC (22050 Hz mono
# 64 kbps) on ingest, and long stitched recordings are segmented
# with ffmpeg stream-copy before transcription.
# Install with:
#   Windows: winget install Gyan.FFmpeg
#   Linux:   sudo apt install ffmpeg   (or: dnf install ffmpeg)
#   macOS:   brew install ffmpeg
AFTERWORD_FFMPEG_PATH=ffmpeg

# Soft cap on web upload size in bytes. Default 500 MB. Bump if you
# upload very long recordings (the server re-encodes them to
# ~0.5 MB per minute of AAC).
AFTERWORD_MAX_UPLOAD_BYTES=524288000
# --- Access control -----------------------------------------------------
# With AFTERWORD_HOST other than 127.0.0.1 the server only starts when
# AFTERWORD_WEB_PASSWORD is set (or AFTERWORD_ALLOW_OPEN=1, for a network
# you trust).
# Upload token. Must equal DEVICE_TOKEN in the firmware's secrets.h;
# the device endpoints then require "Authorization: Bearer <token>".
# AFTERWORD_DEVICE_TOKEN=
# Password for the web UI (one user). Device uploads never need it.
# AFTERWORD_WEB_PASSWORD=
# Serve beyond this PC without a password (not recommended).
# AFTERWORD_ALLOW_OPEN=1
# Key for the login cookie. Unset = generated once into data/db/secret_key.
# AFTERWORD_SECRET=
# Behind HTTPS (Caddy): send the login cookie over HTTPS only.
# AFTERWORD_COOKIE_SECURE=1

# --- Production (python serve.py, waitress) ----------------------------
# Trust X-Forwarded-* from this proxy address (Caddy on the same box).
# AFTERWORD_TRUSTED_PROXY=127.0.0.1

# Local timezone: timestamps without an offset (device started_at, form
# inputs) are read in this zone, and pages show it. Storage is UTC.
# AFTERWORD_TIMEZONE=Europe/London
