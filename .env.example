# Copy this file to `.env` and edit. .env is gitignored.

# Where all data lives: SQLite DB + per-session audio files.
# Default: ./data  (relative to the directory you run `python app.py` from)
LR_DATA_DIR=./data

# Network bind.
#   LR_HOST=127.0.0.1   # only this PC
#   LR_HOST=0.0.0.0     # anything on the LAN (default; this is a LAN-only app)
LR_HOST=0.0.0.0
LR_PORT=8000

# API keys. Both the transcription model and the text model are
# called through OpenRouter (https://openrouter.ai/), so the same
# key works for both — paste it in both lines.
#   LR_TRANSCRIPTION_API_KEY   audio → text  (microsoft/mai-transcribe-2)
#   LR_TEXT_API_KEY            summaries, key points, classification
# Legacy fallbacks are still read when the new names are unset:
#   LR_OPENROUTER_API_KEY (either provider), LR_MINIMAX_API_KEY (text only).
LR_TRANSCRIPTION_API_KEY=
LR_TEXT_API_KEY=

# Speaker annotations. When the transcription model returns
# diarization data, transcripts are rendered as
# "[MM:SS] Speaker N: ..." lines. Set to 0 to always get plain text.
LR_TRANSCRIBE_SPEAKERS=1

# Long recordings are automatically split into chunks. With MP3
# compression on, chunking is duration-driven: the default 1500 s
# (25 min) is ~12 MB of MP3 per request (~16 MB body, well under
# OpenRouter's caps), so a 2-hour lecture is ~5 requests. Without
# ffmpeg (WAV fallback), chunks are capped at 15 MB / 300 s for
# request-size safety. Chunks that fail upstream (timeout, 5xx,
# oversized body) are automatically split in half and retried.
LR_TRANSCRIBE_CHUNK_MB=15
LR_TRANSCRIBE_CHUNK_SECONDS=1500

# Provider-specific options for the transcription request (JSON
# object). The default enables Azure diarization, which is required
# for speaker labels on microsoft/mai-transcribe-2. Only change
# this if you switch to a model served by a different provider;
# set to {} to send no provider options.
# LR_TRANSCRIBE_PROVIDER_OPTIONS={"azure":{"diarization":{"enabled":true}}}

# Chunk compression. Before upload, each WAV chunk is transcoded to
# 64 kbps MP3 with ffmpeg (same binary as LR_FFMPEG_PATH), which
# shrinks request bodies ~10x — from ~20 MB to ~2 MB per chunk —
# and keeps them far below OpenRouter's request-size caps (25 MB
# multipart / 50 MB JSON). Requires ffmpeg; falls back to raw WAV
# automatically when ffmpeg is unavailable. Set to 0 to disable.
LR_TRANSCRIBE_COMPRESS=1

# Web upload.
# ffmpeg is required to transcode non-WAV uploads (e.g. iPhone Voice Memos
# which are M4A/AAC). Without it, the upload page still works for WAV and
# for any format the browser can decode natively (MP3, OGG, FLAC, WebM).
# Install with:
#   Windows: winget install Gyan.FFmpeg
#   Linux:   sudo apt install ffmpeg   (or: dnf install ffmpeg)
#   macOS:   brew install ffmpeg
LR_FFMPEG_PATH=ffmpeg

# Soft cap on web upload size in bytes. Default 500 MB. Bump if you
# record long lectures at 22050 Hz mono 32-bit (~20 MB per minute).
LR_MAX_UPLOAD_BYTES=524288000