# Copy this file to `.env` and edit. .env is gitignored.

# Where all data lives: SQLite DB + per-session audio files.
# Default: ./data  (relative to the directory you run `python app.py` from)
LR_DATA_DIR=./data

# Network bind.
#   LR_HOST=127.0.0.1   # only this PC
#   LR_HOST=0.0.0.0     # anything on the LAN (default; this is a LAN-only app)
LR_HOST=0.0.0.0
LR_PORT=8000

# Future-use API keys (Phase A does not call any LLM service).
# OpenRouter: https://openrouter.ai/  (will be used for audio transcription)
# MiniMax:    https://...              (will be used for summaries / extraction)
LR_OPENROUTER_API_KEY=
LR_MINIMAX_API_KEY=

# Web upload.
# ffmpeg is required to transcode non-WAV uploads (e.g. iPhone Voice Memos
# which are M4A/AAC). Without it, the upload page still works for WAV and
# for any format the browser can decode natively (MP3, OGG, FLAC, WebM).
# Install with:
#   Windows: winget install Gyan.FFmpeg
#   Linux:   sudo apt install ffmpeg   (or: dnf install ffmpeg)
#   macOS:   brew install ffmpeg
LR_FFMPEG_PATH=ffmpeg

# Soft cap on web upload size in bytes. Default 500 MB. Bump if you
# record long lectures at 22050 Hz mono 32-bit (~20 MB per minute).
LR_MAX_UPLOAD_BYTES=524288000
