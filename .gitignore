# Repo root: AI_NoteTaker monorepo (Server/ + Hardware/).
# Server/ has its own .gitignore for Python/data rules.

# Hardware: pre-git firmware copies (V0.1..V0.6). History lives in git
# from fw-v0.4 onward; these are kept locally only for reference.
Hardware/old_versions/

# Hardware: stray local data, build output.
Hardware/data/
Hardware/**/build/

# Hardware: per-device secrets (copy secrets.example.h -> secrets.h).
Hardware/AI_NoteTaker/secrets.h

# Editor / OS
*.code-workspace
.vscode/
.DS_Store
Thumbs.db
