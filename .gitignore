# AfterWord: the recorder (hardware/) and its server (server/).
# server/ has its own .gitignore for Python/data rules.

# Editor / OS
*.code-workspace
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~

# Python caches (hardware/tools scripts)
__pycache__/

# Firmware: ESP-IDF firmware build output.  sdkconfig is generated from
# sdkconfig.defaults; managed_components/ is re-downloaded from
# dependencies.lock (which is committed).
hardware/firmware/build/
hardware/firmware/sdkconfig
hardware/firmware/sdkconfig.old
hardware/firmware/managed_components/

# Firmware: per-device secrets (copy secrets.example.h -> secrets.h).
hardware/firmware/main/secrets.h

# Host test build output (hardware/firmware/test).
hardware/firmware/test/*.exe
hardware/firmware/test/*.tmp

