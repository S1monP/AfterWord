# Repo root: AI_NoteTaker monorepo (Server/ + Hardware/).
# Server/ has its own .gitignore for Python/data rules.

# Editor / OS
*.code-workspace
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~

# Python caches (Hardware/tools scripts)
__pycache__/

# Hardware: ESP-IDF firmware build output.  sdkconfig is generated from
# sdkconfig.defaults; managed_components/ is re-downloaded from
# dependencies.lock (which is committed).
Hardware/firmware/build/
Hardware/firmware/sdkconfig
Hardware/firmware/sdkconfig.old
Hardware/firmware/managed_components/

# Hardware: per-device secrets (copy secrets.example.h -> secrets.h).
Hardware/firmware/main/secrets.h
