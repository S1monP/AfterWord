# Data directory: all recordings, metadata DB, and per-session files.
# Deleting this folder resets the server to a clean slate.
data/

# Python
__pycache__/
*.py[cod]
*.pyc.bak
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Local environment file (secrets)
.env
.envrc

# Editor leftovers (editor/OS rules live in the root .gitignore)
*.swo
*.bak
*.orig
*.tmp

# Coverage
.coverage
coverage.xml
htmlcov/

# Test log written by scripts/run_tests.py.
test.log

